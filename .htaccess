# ===== WIP / MANUTENZIONE — INIZIO =====
# Per DISATTIVARE: commenta o elimina questo intero blocco.
# Gli asset (assets/, css/, js/) restano raggiungibili; tutto il resto va su /wip.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/wip\.html$ [NC]
  RewriteCond %{REQUEST_URI} !^/assets/ [NC]
  RewriteCond %{REQUEST_URI} !^/css/ [NC]
  RewriteCond %{REQUEST_URI} !^/js/ [NC]
  RewriteRule ^ /wip.html [R=302,L]
</IfModule>
# ===== WIP / MANUTENZIONE — FINE =====

# ===== Compressione GZIP =====
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ===== Cache browser =====
<IfModule mod_expires.c>
  ExpiresActive On
  # Immagini: 1 anno
  ExpiresByType image/webp  "access plus 1 year"
  ExpiresByType image/png   "access plus 1 year"
  ExpiresByType image/jpeg  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  # CSS e JS: 1 mese
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  # HTML: niente cache (sempre fresco)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ===== Security headers =====
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Cache immutable per asset versioned
  <FilesMatch "\.(css|js|webp|png|jpg|svg|woff2)$">
    Header append Cache-Control "public, immutable"
  </FilesMatch>
</IfModule>

# ===== MIME types =====
AddType image/webp .webp
