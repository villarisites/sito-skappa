# ===== WIP / MANUTENZIONE — INIZIO =====
# Per DISATTIVARE: commenta o elimina questo intero blocco.
# Gli asset (assets/, css/, js/) restano raggiungibili; tutto il resto va su /wip.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/wip\.html$ [NC]
  RewriteCond %{REQUEST_URI} !^/assets/ [NC]
  RewriteCond %{REQUEST_URI} !^/css/ [NC]
  RewriteCond %{REQUEST_URI} !^/js/ [NC]
  RewriteRule ^ /wip.html [R=302,L]
</IfModule>
# ===== WIP / MANUTENZIONE — FINE =====

# ===== Protezione pannelli amministrativi (Basic Auth) =====
# 1. Genera il file .htpasswd FUORI dalla webroot pubblica (o comunque non raggiungibile via URL), es.:
#      htpasswd -c -B /percorso/assoluto/fuori/dalla/webroot/.htpasswd_skappa nome_utente
#    (-B usa bcrypt; se il tuo host non lo supporta, ometti -B per usare MD5-crypt di Apache)
# 2. Sostituisci AuthUserFile qui sotto con il percorso assoluto reale sul server
#    (su hosting condiviso è tipicamente qualcosa come /home/<utente_cpanel>/.htpasswd_skappa).
# 3. NON committare mai il file .htpasswd nel repository Git.
<Files "admin.html">
  AuthType Basic
  AuthName "Area riservata SKAPPA"
  AuthUserFile /percorso/assoluto/fuori/dalla/webroot/.htpasswd_skappa
  Require valid-user
</Files>
<Files "preventivi-manager.html">
  AuthType Basic
  AuthName "Area riservata SKAPPA"
  AuthUserFile /percorso/assoluto/fuori/dalla/webroot/.htpasswd_skappa
  Require valid-user
</Files>

# ===== Compressione GZIP =====
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ===== Cache browser =====
<IfModule mod_expires.c>
  ExpiresActive On
  # Immagini: 1 anno
  ExpiresByType image/webp  "access plus 1 year"
  ExpiresByType image/png   "access plus 1 year"
  ExpiresByType image/jpeg  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  # CSS e JS: 1 mese
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  # HTML: niente cache (sempre fresco)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ===== Security headers =====
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Cache immutable per asset versioned
  <FilesMatch "\.(css|js|webp|png|jpg|svg|woff2)$">
    Header append Cache-Control "public, immutable"
  </FilesMatch>
</IfModule>

# ===== MIME types =====
AddType image/webp .webp
